		formatString: yyyy-MM-dd HH:mm
		lineageTag: 12d119b0-dd75-47a2-ac4d-191caaf55cbe
		summarizeBy: none
		sourceColumn: batch_timestamp

		variation Variation
			isDefault
			relationship: 4a16f1b6-d64e-4a46-8572-e3673b4bf497
			defaultHierarchy: LocalDateTable_8e8ba00f-da6b-4b54-9ada-b8552e9bf2b2.'Date Hierarchy'

