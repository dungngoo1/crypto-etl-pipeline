			defaultHierarchy: LocalDateTable_39c4b735-efe4-4938-a3ed-cba4cae4ed72.'Date Hierarchy'

	column symbol
		dataType: string
		lineageTag: 904682e4-7857-4bc3-9b56-5f11f34670f1
		summarizeBy: none
		sourceColumn: symbol

	column base_asset
		dataType: string
		lineageTag: f26ec9b6-32cd-430c-8755-3134447a9fb4
