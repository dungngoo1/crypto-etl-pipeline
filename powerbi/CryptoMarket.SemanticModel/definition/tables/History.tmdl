	column snapshot_timestamp
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		lineageTag: bbd7e9fd-63e9-49c1-9fe9-9f0d55bb27b7
		summarizeBy: none
		sourceColumn: snapshot_timestamp

		variation Variation
			isDefault
			relationship: dce68376-87e6-4743-9a3d-99c99ab22862
			defaultHierarchy: LocalDateTable_71872039-025f-402e-a501-6f2322d95140.'Date Hierarchy'

	partition History = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),
				    Data = Source{[Schema="ga", Item="symbol_history"]}[Data],
				    UTC = Table.TransformColumns(Data, {{"batch_timestamp", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type nullable datetime}, {"ingested_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type nullable datetime}, {"snapshot_timestamp", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type nullable datetime}})
				in UTC
