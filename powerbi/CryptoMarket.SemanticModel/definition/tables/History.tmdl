table History
	lineageTag: c33ace00-11c2-4b8c-bc9e-e4b050aed2aa

	measure 'Pair price' = IF(HASONEVALUE(History[symbol]), MAX(History[current_price]))
		formatString: #,0.########
		lineageTag: 5e2f9a27-3f74-4c5d-a5ea-d509d64a01c1

	column metric_key
		dataType: string
		lineageTag: 5b255ada-fabf-4068-86bf-b3237fb77c75
