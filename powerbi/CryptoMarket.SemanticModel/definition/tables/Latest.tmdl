table Latest
	lineageTag: afbad80a-91d8-4596-a82f-3580c4455444

	measure 'Active pairs' = COUNTROWS(Latest)
		formatString: #,0
		lineageTag: 4cee4261-5e84-4c4f-840f-d4ed3f70f8dd

	measure 'Volume 24h' = IF(HASONEVALUE(Latest[quote_asset]), SUM(Latest[volume_quote_24h]))
		formatString: #,0.00
		lineageTag: a7634748-1ea6-476d-ae1e-5ce13de1de8b

	measure 'Average change 24h' = IF(HASONEVALUE(Latest[quote_asset]), AVERAGE(Latest[price_change_percent_24h]) / 100)
		formatString: 0.00%
		lineageTag: cdea60f6-9a78-4a02-9ea1-bf718a9bd8cc

	measure 'Change 24h' = AVERAGE(Latest[price_change_percent_24h]) / 100
		formatString: 0.00%
		lineageTag: 13e7e308-60e3-4f0a-9dfb-ad1aae2429f4

	measure 'Last snapshot UTC' = FORMAT(MAX(Latest[ingested_at]), "yyyy-MM-dd HH:mm")
		lineageTag: 15707dc9-f60e-414c-b15e-3334882cea83

