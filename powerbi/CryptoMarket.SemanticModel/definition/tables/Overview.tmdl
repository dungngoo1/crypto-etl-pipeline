table Overview
	lineageTag: d17f654e-8ba3-47db-b64e-ce9c5e6917fd

	measure 'Rolling quote volume' = IF(HASONEVALUE(Overview[quote_asset]) && HASONEVALUE(Overview[batch_id]), MAX(Overview[volume_quote_24h]))
		formatString: #,0
		lineageTag: 38bad6db-8d18-442a-9463-448d3c0c5d84

	measure 'Pair breadth' = IF(HASONEVALUE(Overview[quote_asset]) && HASONEVALUE(Overview[batch_id]), MAX(Overview[active_pairs]))
		formatString: #,0
		lineageTag: 7cc07d3d-985c-4c8b-9ee9-0fb097aeae27

