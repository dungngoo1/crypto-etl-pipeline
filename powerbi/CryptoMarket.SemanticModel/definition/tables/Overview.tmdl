	partition Overview = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),
				    Data = Source{[Schema="ga", Item="market_overview"]}[Data],
				    UTC = Table.TransformColumns(Data, {{"batch_timestamp", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type nullable datetime}, {"captured_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type nullable datetime}})
				in UTC
